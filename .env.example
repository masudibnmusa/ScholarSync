NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable (anon) key
DATABASE_URL=                         # server only: Postgres connection string (Supabase pooler, transaction mode)
GEMINI_API_KEY=                       # server only: Google AI Studio key for the AI jobs
# GEMINI_MODEL=gemini-3.5-flash-lite # optional override
INNGEST_EVENT_KEY=                    # production only
INNGEST_SIGNING_KEY=                  # production only
# INNGEST_DEV=1                       # local: use the Inngest dev server
APP_URL=                              # public site URL, used for links in emails (default http://localhost:3000)
RESEND_API_KEY=                       # production: Resend key for the daily email digest
EMAIL_FROM=                           # e.g. ScholarSync <digest@yourdomain.com>
# MAILPIT_URL=http://127.0.0.1:54324  # local: defaults to Supabase's Mailpit in development

# Web push (phone/desktop alerts). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-university.edu

# GitHub per team (optional): without a token, public repos only, at 60 API requests an hour for the whole server.
# A fine-grained token with read access to the course's repos allows private repos and 5,000 requests an hour.
GITHUB_TOKEN=

# Error monitoring (optional): a Sentry project's DSN. Unset = nothing is reported.
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production   # defaults to NODE_ENV
